# --- Obligatorias para la app (middleware, login, sesión) ---
# Supabase → Project Settings → API: "Project URL" y clave "anon" "public".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional (mismo valor que la URL del proyecto, sin NEXT_PUBLIC_).
# SUPABASE_URL=

# Opcional (misma clave anon, si no quieres duplicar en NEXT_PUBLIC_*).
# SUPABASE_ANON_KEY=

# --- Solo servidor (sincronizar judicial); nunca en el cliente ---
SUPABASE_SERVICE_ROLE_KEY=

# SCRAPING_TIMEOUT_MS=30000

# --- Telegram (notificaciones; reemplaza Resend) ---
# Token del bot (@BotFather). Sync manual: envío local; si falta, usa Edge (CRON_SECRET).
TELEGRAM_BOT_TOKEN=
# Username del bot sin @ (enlace t.me/... en Perfil)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# URL pública del panel (enlaces en Perfil y sync manual desde Next)
# Producción: https://cj-full-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Edge Functions / sync manual sin TELEGRAM_BOT_TOKEN en Next ---
# Mismo CRON_SECRET que en Supabase Edge Secrets (telegram-send-pending, sync-tick, etc.)
CRON_SECRET=

# --- Solo en Supabase Edge Secrets (no obligatorio duplicar en Next si usas CRON_SECRET arriba) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET= # query ?token= en telegram-webhook
# Mismo dominio que NEXT_PUBLIC_APP_URL, pero en Supabase Edge Secrets (Telegram/crons):
# APP_PUBLIC_URL=https://cj-full-app.vercel.app
# HEALTH_STALE_HOURS=48
# HEALTH_UNREAD_CRITICAL_HOURS=24
