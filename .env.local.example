# --- Obligatorias para la app (middleware, login, sesión) ---
# Supabase → Project Settings → API: "Project URL" y clave "anon" "public".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional (mismo valor que la URL del proyecto, sin NEXT_PUBLIC_).
# SUPABASE_URL=

# Opcional (misma clave anon, si no quieres duplicar en NEXT_PUBLIC_*).
# SUPABASE_ANON_KEY=

# --- Solo servidor (sincronizar judicial); nunca en el cliente ---
SUPABASE_SERVICE_ROLE_KEY=

# SCRAPING_TIMEOUT_MS=30000

# --- Opcional: correo (Resend) tras sincronizar alertas críticas/urgentes ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Consultorio <onboarding@resend.dev>"
# URL pública del panel (enlaces en el correo)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Edge Functions (Supabase secrets; no en el cliente Next) ---
# CRON_SECRET= # Bearer: sync-tick, sync-one-caso, health-check, sync-judicial-casos
# APP_PUBLIC_URL= # enlaces en correos desde Edge
# HEALTH_STALE_HOURS=48
# HEALTH_UNREAD_CRITICAL_HOURS=24
# ADMIN_ALERT_EMAIL= # opcional: un solo buzón; si vacío → todos los profiles admin
